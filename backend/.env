# Copy to .env and fill in. Never commit .env.

# development | production
ENV=development

# REQUIRED in production: a long random string.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-dev-only-secret-change-me-dev-only-secret

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# SQLite for development. For production use Postgres, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/kaamsetu
DATABASE_URL=sqlite:///./kaamsetu.db

# Comma-separated list of allowed browser origins
FRONTEND_ORIGINS=http://localhost:5173

# Hostnames the API answers to in production (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Claude API key for the assistant. Leave empty to run the assistant in
# offline mode (it answers by quoting the knowledge base directly).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Optional: Redis URL to scale Socket.IO across several server processes
REDIS_URL=
